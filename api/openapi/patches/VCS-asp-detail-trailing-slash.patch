             application/json:
               schema:
                 $ref: '#/components/schemas/AutoScalingPolicySerializer'
-  /auto_scaling_policies/{auto_scaling_policy_id}:
+  /auto_scaling_policies/{auto_scaling_policy_id}/:
     get:
       tags:
         - auto scaling policy
