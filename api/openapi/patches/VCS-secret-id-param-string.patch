# 真實環境（2026-08-28 read-only 實測）GET /secrets/1/ 回 404 `Secret 1 not found`，
# GET /secrets/<uuid>/ 回 302（路由不接受非整數），而 spec SecretSerializer.id 標 string、
# SecretIDParam 標 integer 自相矛盾；path 參數改為 string 以同時容納兩種可能。
#
# 另外 SecretSerializer.id 維持嚴格 string 型別時，oapi-codegen 生成的
# ParseGetSecretsResponse／ParsePostSecretsResponse／ParseGetSecretsSecretIdResponse
# 會在 WithResponse 內先以生成型別 SecretSerializer 對回應 body 做 eager unmarshal，
# 一旦真實 id 是數字就會直接失敗、整個 WithResponse 回傳 nil, err，
# 連原始 body 都拿不到——因此把 SecretSerializer.id 由 `type: string` 放寬成無型別限制
# （oapi-codegen 對應生成 interface{}），讓 eager unmarshal 一律成功；實際型別轉換交由
# 手寫的 vcs.Secret + FlexibleID 寬鬆解析。詳見 docs/api-notes.md A28。
--- a/api/openapi/VCS.yaml
+++ b/api/openapi/VCS.yaml
@@ -4109,8 +4109,7 @@
         expire_time:
           type: string
           format: date-time
-        id:
-          type: string
+        id: {}
         name:
           type: string
         project:
@@ -4723,7 +4722,7 @@
       description: secret ID
       required: true
       schema:
-        type: integer
+        type: string
     FirewallIDParam:
       name: firewall_id
       in: path
