# 真實環境（2026-08-28 寫入型實測，project ENT000000）：POST /secrets/?project=60000
# body 只有 name/payload/desc（project 只放在 query）→ 400
# {'project': ['This field is required.']}；body 加上 "project": 60000（query 也保留）
# → 200。spec 只把 project 標在 query（ProjectInQueryParam），未標在 requestBody，
# 導致依 spec 產生的 request body 一定會被真實 API 拒絕；補上 requestBody.project
# （必填 integer）反映實際行為。詳見 docs/api-notes.md A28。
--- a/api/openapi/VCS.yaml
+++ b/api/openapi/VCS.yaml
@@ -2377,6 +2377,7 @@
               required:
               - name
               - payload
+              - project
               properties:
                 name:
                   type: string
@@ -2391,6 +2392,10 @@
                 desc:
                   type: string
                   description: Secret description
+                project:
+                  type: integer
+                  description: Project ID（實測必填，spec 原只標在 query）
+                  format: int32
       responses:
         200:
           description: Created
